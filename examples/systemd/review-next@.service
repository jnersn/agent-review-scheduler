# Nightly review on Linux: one instance per plan name, e.g. review-next@example-web.
[Unit]
Description=Nightly code review of %i (agent-review-scheduler)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/review-next %i --nightly
Nice=10
